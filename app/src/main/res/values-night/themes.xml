<?xml version="1.0" encoding="utf-8"?>

<resources>

    <style
        name="Base.Theme.Yedei"
        parent="Theme.Material3.Light.NoActionBar">

        <!-- MANTENER EL TEMA CLARO -->

        <item name="colorPrimary">
            @color/yedei_primary
        </item>

        <item name="colorOnPrimary">
            @color/yedei_text_on_primary
        </item>

        <item name="colorPrimaryContainer">
            @color/yedei_primary_light
        </item>

        <item name="colorOnPrimaryContainer">
            @color/yedei_primary_dark
        </item>

        <item name="colorSecondary">
            @color/yedei_secondary
        </item>

        <item name="colorOnSecondary">
            @color/white
        </item>

        <item name="android:colorBackground">
            @color/yedei_background
        </item>

        <item name="colorSurface">
            @color/yedei_surface
        </item>

        <item name="colorOnSurface">
            @color/yedei_text_primary
        </item>

        <item name="android:statusBarColor">
            @color/yedei_background
        </item>

        <item name="android:navigationBarColor">
            @color/yedei_surface
        </item>

        <item name="android:windowLightStatusBar">
            true
        </item>

        <item name="android:windowLightNavigationBar">
            true
        </item>

        <item name="android:windowBackground">
            @color/yedei_background
        </item>

        <item name="android:windowNoTitle">
            true
        </item>

        <item name="android:colorAccent">
            @color/yedei_primary
        </item>

    </style>

</resources>