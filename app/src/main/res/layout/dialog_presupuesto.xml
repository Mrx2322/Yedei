<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:background="@color/yedei_surface"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"

        android:paddingStart="24dp"
        android:paddingTop="26dp"
        android:paddingEnd="24dp"
        android:paddingBottom="20dp">


        <!-- TÍTULO -->

        <TextView
            android:id="@+id/tvTituloPresupuesto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:text="@string/configure_budget"
            android:textColor="@color/yedei_text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />


        <!-- DESCRIPCIÓN -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="8dp"

            android:lineSpacingExtra="2dp"

            android:text="@string/budget_dialog_help"
            android:textColor="@color/yedei_text_secondary"
            android:textSize="14sp" />


        <!-- SEPARACIÓN VISUAL -->

        <View
            android:layout_width="48dp"
            android:layout_height="4dp"

            android:layout_marginTop="18dp"

            android:background="@color/yedei_primary" />


        <!-- MONTO -->

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutMontoPresupuesto"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="24dp"

            android:hint="@string/budget_amount"

            app:boxCornerRadiusBottomEnd="16dp"
            app:boxCornerRadiusBottomStart="16dp"
            app:boxCornerRadiusTopEnd="16dp"
            app:boxCornerRadiusTopStart="16dp"

            app:boxStrokeColor="@color/yedei_primary"
            app:hintTextColor="@color/yedei_text_secondary"
            app:prefixText="S/ "
            app:prefixTextColor="@color/yedei_primary">


            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etMontoPresupuesto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:digits="0123456789.,"
                android:imeOptions="actionDone"
                android:inputType="numberDecimal"
                android:maxLines="1"
                android:minHeight="58dp"
                android:selectAllOnFocus="true"

                android:textColor="@color/yedei_text_primary"
                android:textSize="20sp"
                android:textStyle="bold"

                tools:text="1500.00" />

        </com.google.android.material.textfield.TextInputLayout>


        <!-- BOTÓN PRINCIPAL -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuardarPresupuesto"
            android:layout_width="match_parent"
            android:layout_height="56dp"

            android:layout_marginTop="26dp"

            android:text="@string/save_budget"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"

            app:backgroundTint="@color/yedei_primary"
            app:cornerRadius="16dp"
            app:elevation="0dp" />


        <!-- CANCELAR -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelarPresupuesto"
            style="?attr/materialButtonOutlinedStyle"

            android:layout_width="match_parent"
            android:layout_height="52dp"

            android:layout_marginTop="10dp"

            android:text="@string/cancel"
            android:textAllCaps="false"
            android:textColor="@color/yedei_primary"
            android:textSize="14sp"

            app:backgroundTint="@color/yedei_surface"
            app:cornerRadius="16dp"
            app:strokeColor="@color/yedei_border"
            app:strokeWidth="1dp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>