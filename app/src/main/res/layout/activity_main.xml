<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/yedei_background"

    tools:context=".MainActivity">


    <!-- CONTENIDO PRINCIPAL -->

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContenido"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingBottom="110dp">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="44dp"
            android:paddingEnd="20dp"
            android:paddingBottom="32dp">


            <!-- SALUDO -->

            <TextView
                android:id="@+id/tvSaludo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_greeting"
                android:textColor="@color/yedei_text_primary"
                android:textSize="27sp"
                android:textStyle="bold" />


            <TextView
                android:id="@+id/tvSubtitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/home_subtitle"
                android:textColor="@color/yedei_text_secondary"
                android:textSize="14sp" />


            <!-- SELECTOR DEL MES -->

            <LinearLayout
                android:id="@+id/layoutSelectorMes"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">


                <TextView
                    android:id="@+id/btnMesAnterior"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/select_date"
                    android:gravity="center"
                    android:text="‹"
                    android:textColor="@color/yedei_primary"
                    android:textSize="32sp"
                    android:textStyle="bold" />


                <TextView
                    android:id="@+id/tvMesActual"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/current_month"
                    android:textColor="@color/yedei_text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    tools:text="Septiembre 2026" />


                <TextView
                    android:id="@+id/btnMesSiguiente"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/select_date"
                    android:gravity="center"
                    android:text="›"
                    android:textColor="@color/yedei_primary"
                    android:textSize="32sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- TARJETA DE SALDO -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/yedei_navy"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/current_balance"
                        android:textColor="#CCFFFFFF"
                        android:textSize="14sp" />


                    <TextView
                        android:id="@+id/tvSaldo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/white"
                        android:textSize="35sp"
                        android:textStyle="bold"
                        tools:text="S/ 0.00" />


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/app_slogan"
                        android:textColor="#99FFFFFF"
                        android:textSize="13sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- INGRESOS Y GASTOS -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:baselineAligned="false"
                android:orientation="horizontal">


                <!-- INGRESOS -->

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="7dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/yedei_income_background"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#3316A34A"
                    app:strokeWidth="1dp">


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="17dp">


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/total_income"
                            android:textColor="@color/yedei_secondary_dark"
                            android:textSize="13sp"
                            android:textStyle="bold" />


                        <TextView
                            android:id="@+id/tvIngresos"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textColor="@color/yedei_income"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            tools:text="S/ 0.00" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- GASTOS -->

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/yedei_expense_background"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#33DC2626"
                    app:strokeWidth="1dp">


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="17dp">


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/total_expenses"
                            android:textColor="@color/yedei_expense"
                            android:textSize="13sp"
                            android:textStyle="bold" />


                        <TextView
                            android:id="@+id/tvGastos"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textColor="@color/yedei_expense"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            tools:text="S/ 0.00" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>


            <!-- PRESUPUESTO -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPresupuesto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/yedei_surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/yedei_border"
                app:strokeWidth="1dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="19dp">


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">


                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/monthly_budget"
                            android:textColor="@color/yedei_text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />


                        <TextView
                            android:id="@+id/tvPorcentajePresupuesto"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/yedei_primary"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            tools:text="0%" />

                    </LinearLayout>


                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progresoPresupuesto"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="16dp"
                        android:max="100"
                        android:progress="0"
                        app:indicatorColor="@color/yedei_primary"
                        app:trackColor="@color/yedei_primary_light"
                        app:trackCornerRadius="4dp"
                        app:trackThickness="8dp" />


                    <TextView
                        android:id="@+id/tvDetallePresupuesto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="@color/yedei_text_secondary"
                        android:textSize="13sp"
                        tools:text="S/ 0.00 disponibles de S/ 0.00" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- MOVIMIENTOS RECIENTES -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">


                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/recent_movements"
                    android:textColor="@color/yedei_text_primary"
                    android:textSize="19sp"
                    android:textStyle="bold" />


                <TextView
                    android:id="@+id/tvVerTodos"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="4dp"
                    android:text="@string/view_all"
                    android:textColor="@color/yedei_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- LISTA DE MOVIMIENTOS -->

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMovimientos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:visibility="gone"
                tools:itemCount="3"
                tools:listitem="@android:layout/simple_list_item_2"
                tools:visibility="visible" />


            <!-- ESTADO VACÍO -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/layoutSinMovimientos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/yedei_surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/yedei_border"
                app:strokeWidth="1dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingTop="30dp"
                    android:paddingEnd="24dp"
                    android:paddingBottom="30dp">


                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/no_movements"
                        android:textColor="@color/yedei_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />


                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="@string/no_movements_help"
                        android:textColor="@color/yedei_text_secondary"
                        android:textSize="13sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>


    <!-- BOTÓN AGREGAR -->

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabAgregarMovimiento"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="22dp"
        android:contentDescription="@string/content_description_add"
        android:text="@string/add_movement"
        android:textColor="@color/white"
        app:backgroundTint="@color/yedei_primary"
        app:elevation="6dp" />

</FrameLayout>