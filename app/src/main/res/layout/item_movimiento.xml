<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:id="@+id/cardMovimiento"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"

    app:cardBackgroundColor="#F7FFFFFF"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeColor="#DCE2EE"
    app:strokeWidth="1dp">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:gravity="center_vertical"
        android:orientation="horizontal"

        android:padding="18dp">


        <!-- INDICADOR DEL TIPO -->

        <FrameLayout
            android:layout_width="42dp"
            android:layout_height="42dp">

            <!-- El adapter sigue encontrando este TextView, pero no se muestra. -->
            <TextView
                android:id="@+id/tvIconoMovimiento"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_dinero" />

        </FrameLayout>


        <!-- INFORMACIÓN -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_marginStart="12dp"
            android:layout_weight="1"

            android:orientation="vertical">


            <TextView
                android:id="@+id/tvCategoriaMovimiento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:ellipsize="end"
                android:maxLines="1"

                android:textColor="#25304A"
                android:textSize="15sp"
                android:textStyle="bold"

                tools:text="Sueldo" />


            <TextView
                android:id="@+id/tvDescripcionMovimiento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="3dp"

                android:ellipsize="end"
                android:maxLines="1"

                android:textColor="#596579"
                android:textSize="13sp"

                tools:text="Pago del mes" />


            <TextView
                android:id="@+id/tvFechaMovimiento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="4dp"

                android:textColor="#667085"
                android:textSize="12sp"

                tools:text="16 de septiembre" />

        </LinearLayout>


        <!-- MONTO -->

        <TextView
            android:id="@+id/tvMontoMovimiento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginStart="10dp"

            android:gravity="end"
            android:maxLines="1"

            android:textColor="@color/yedei_income"
            android:textSize="15sp"
            android:textStyle="bold"

            tools:text="+ S/ 1,500.00" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
